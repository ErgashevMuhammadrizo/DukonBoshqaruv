# Root-level environment template for local clone / GitHub setup.
# Copy to .env before running Docker or local backend tools.

DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key-please
DEBUG=1
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2
DB_ENGINE=sqlite

# PostgreSQL settings used by docker-compose for local stack.
POSTGRES_DB=dokon
POSTGRES_USER=dokon
POSTGRES_PASSWORD=dokon123
POSTGRES_HOST=db
POSTGRES_PORT=5432

LOG_LEVEL=INFO
NUM_PROXIES=1
SECURE_SSL_REDIRECT=0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://10.0.2.2:8000
