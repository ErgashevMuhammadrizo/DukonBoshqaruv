cat > .gitignore <<'EOF'
# Secrets and local environment
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Django generated files and local data
backend/media/
backend/staticfiles/
var/backups/

# Flutter / Dart
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
**/app.*.symbols
**/app.*.map.json

# Android generated build outputs
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# IDE and OS
.vscode/
.idea/
*.iml
*.ipr
*.iws
.DS_Store
*.swp
*.log
.atom/
.history/
.svn/
.build/
.buildlog/
migrate_working_dir/
.swiftpm/
EOF