# Copy to .env and provide deployment-specific values. Never commit real credentials.
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DEBUG=0
APP_ENV=production
ALLOWED_HOSTS=example.com
DB_ENGINE=postgres
PGDATABASE=dokon
PGUSER=dokon
PGPASSWORD=replace-me
PGHOST=db
PGPORT=5432
PGSSLMODE=require
BACKUP_DIR=/var/backups/dokon
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
LOG_LEVEL=INFO
NUM_PROXIES=1
CSRF_TRUSTED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

# Optional, external encrypted/off-site backup status path.
BACKUP_STATUS_FILE=

# Placeholders only. The current application does not yet call either provider.
# Do not configure production credentials until the provider adapters and callbacks are implemented.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_LOGIN=
PAYME_PASSWORD=

# API-only by default. See PRODUCTION_AUDIT_UZ.md for integrated website builds.
SERVE_WEBSITE=0
# WEBSITE_ROOT=/website

# Only for an intentionally SQLite deployment with a persistent volume:
# DB_ENGINE=sqlite
# SQLITE_PATH=/data/vexo.sqlite3
